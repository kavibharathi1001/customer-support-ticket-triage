# ===============================
# Customer Support Ticket Triage
# ===============================

import pandas as pd
import re
from datetime import datetime, timedelta

# -------------------------------
# Load Dataset
# -------------------------------
df = pd.read_csv("customer_tickets.csv")

print("Dataset Preview:")
print(df.head())

# -------------------------------
# Data Cleaning Function
# -------------------------------
def clean_text(text):
    text = text.lower()
    text = re.sub(r'[^a-z\s]', '', text)
    text = re.sub(r'\s+', ' ', text).strip()
    return text

df["clean_message"] = df["message"].apply(clean_text)

# -------------------------------
# Issue Classification
# -------------------------------
def classify_issue(msg):
    if "payment" in msg or "deducted" in msg:
        return "PAYMENT"
    elif "login" in msg or "sign" in msg:
        return "LOGIN"
    elif "deliver" in msg or "delay" in msg:
        return "DELIVERY"
    elif "refund" in msg:
        return "REFUND"
    elif "crash" in msg or "bug" in msg or "error" in msg:
        return "BUG"
    else:
        return "GENERAL"

df["issue_type"] = df["clean_message"].apply(classify_issue)

# -------------------------------
# Priority Assignment
# -------------------------------
def assign_priority(msg):
    if "unable" in msg or "deducted" in msg or "crash" in msg:
        return "P0"
    elif "delay" in msg or "refund" in msg:
        return "P1"
    elif "how" in msg:
        return "P2"
    else:
        return "P3"

df["priority"] = df["clean_message"].apply(assign_priority)

# -------------------------------
# SLA Hours Mapping
# -------------------------------
sla_map = {
    "P0": 2,
    "P1": 6,
    "P2": 12,
    "P3": 24
}

df["sla_hours"] = df["priority"].map(sla_map)

# -------------------------------
# Due Time Calculation
# -------------------------------
df["created_at"] = pd.to_datetime(df["created_at"])
df["due_time"] = df.apply(
    lambda row: row["created_at"] + timedelta(hours=row["sla_hours"]),
    axis=1
)

# -------------------------------
# Final Output
# -------------------------------
final_columns = [
    "ticket_id",
    "message",
    "issue_type",
    "priority",
    "sla_hours",
    "created_at",
    "due_time"
]

final_df = df[final_columns]

print("\nFinal Processed Data:")
print(final_df)

# -------------------------------
# Export to CSV
# -------------------------------
final_df.to_csv("final_ticket_triage_output.csv", index=False)

print("\n✅ Output CSV Generated Successfully!")
